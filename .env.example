# Copy to .env and fill in. Never commit .env.
#
# Milestone 1 only reads DATABASE_URL. The remaining keys are placeholders for
# later milestones and can stay empty until then.

# --- Storage -----------------------------------------------------------------
# Local dev default (SQLite). Switch to Postgres with:
#   DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/travel_agent
DATABASE_URL=sqlite+aiosqlite:///./travel_agent.db

# Create tables on startup. Fine for SQLite dev; use Alembic for Postgres.
AUTO_CREATE_TABLES=true

# --- LLM (Milestone 3+) ------------------------------------------------------
OPENAI_API_KEY=

# --- Flights (Milestone 5) ---------------------------------------------------
DUFFEL_ACCESS_TOKEN=

# --- Places + Routes (Milestone 2) -------------------------------------------
GOOGLE_MAPS_API_KEY=

# --- Hotels (Milestone 6) ----------------------------------------------------
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# --- Weather -----------------------------------------------------------------
WEATHER_API_KEY=
