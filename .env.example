# Copy to .env and fill in. Never commit .env.
#
# Milestones 1-2 read DATABASE_URL and GOOGLE_MAPS_API_KEY. The rest are
# placeholders for later milestones and can stay empty until then.

# --- Storage -----------------------------------------------------------------
# Local dev default (SQLite). Switch to Postgres with:
#   DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/travel_agent
DATABASE_URL=sqlite+aiosqlite:///./travel_agent.db

# Create tables on startup. Fine for SQLite dev; use Alembic for Postgres.
AUTO_CREATE_TABLES=true

# --- Places + Routes (Milestone 2) -------------------------------------------
# One key, with BOTH of these enabled in Google Cloud Console -> APIs & Services:
#   * Places API (New)      <- the "(New)" one; the legacy Places API will not work
#   * Routes API
# Billing must be enabled on the project. Restrict the key to those two APIs.
GOOGLE_MAPS_API_KEY=

# --- Weather ------------------------------------------------------------------
# Optional. Falls back to GOOGLE_MAPS_API_KEY; either way the key needs
# "Weather API" enabled, which is separate again from Places, Routes and Maps
# JavaScript. Only the forecast half needs it.
#
# Historical weather comes from Open-Meteo, which requires no key and is not
# configured here. There is deliberately no setting for it: inventing one for a
# credential that does not exist would be a lie in this file.
WEATHER_API_KEY=

# --- The map in the web UI ---------------------------------------------------
# Optional. Falls back to GOOGLE_MAPS_API_KEY above, which is fine on localhost
# and only there: the page publishes whatever key it loads, so a shared key also
# hands out your Places and Routes budget. You cannot solve that with an HTTP
# referrer restriction, because the same restriction breaks the server's calls -
# it needs to be a second key.
#
# Whichever key the browser gets needs "Maps JavaScript API" enabled. That is a
# separate API from the two above.
MAPS_BROWSER_API_KEY=

# Response language and region bias. Set region to JP for a Japan trip if you
# want Japanese-localized results.
GOOGLE_PLACES_LANGUAGE=en
GOOGLE_PLACES_REGION=

# Durable half of the tool cache. Only place ids (indefinitely) and lat/lng
# (<=30 days) ever persist - see app/services/cache.py for why.
CACHE_ENABLED=true

# --- LLM (Milestone 3+) ------------------------------------------------------
OPENAI_API_KEY=

# --- Flights (Milestone 5) ---------------------------------------------------
DUFFEL_ACCESS_TOKEN=

# --- Hotels (Milestone 6) ----------------------------------------------------
# Google Hotels prices, read through SerpApi: https://serpapi.com/google-hotels-api
#
# The spec named Amadeus here. Amadeus Self-Service was decommissioned on
# 17 July 2026, so it is gone - see app/providers/hotel_provider.py.
#
# Without this key, recommending a neighbourhood still works (it needs only
# Google); searching hotel prices says it is not configured.
SERPAPI_API_KEY=

# --- Weather -----------------------------------------------------------------
WEATHER_API_KEY=

# --- What one turn may spend -------------------------------------------------
# You supply the keys, so these are what stands between a confused model and
# your bill. Every default sits above the most expensive turn ever measured
# against this codebase: they bound a runaway without cutting off real work.
# SECURITY.md has the table and what each one covers.
#
# Model rounds per turn. Reaching it ends the turn and says so.
AGENT_MAX_ITERATIONS=16
# Tokens for a whole turn, input plus output. The most expensive legitimate
# turn measured here used 280,311.
AGENT_MAX_TURN_TOKENS=500000
# Paid provider calls per turn, counted per provider at the one function all of
# them pass through. Cache hits never reach it and cost nothing.
TURN_GOOGLE_CALL_BUDGET=120
TURN_FLIGHT_CALL_BUDGET=20
TURN_HOTEL_CALL_BUDGET=20
TURN_PROVIDER_CALL_BUDGET=50
# One model reply, and one model call. This counts REASONING tokens too, so
# it is set loose on purpose - a ceiling is not a reservation, and unused
# headroom is never billed. The SDK's own defaults are no output limit, a 600s
# timeout and two silent retries.
OPENAI_MAX_OUTPUT_TOKENS=32000
OPENAI_REQUEST_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=1
